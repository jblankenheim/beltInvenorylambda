const { DynamoDBClient } = require('@aws-sdk/client-dynamodb');
const { DynamoDBDocumentClient, ScanCommand, UpdateCommand } = require('@aws-sdk/lib-dynamodb');
const awsServerlessExpressMiddleware = require('aws-serverless-express/middleware');
const express = require('express');
const bodyParser = require('body-parser');
const awsServerlessExpress = require('aws-serverless-express');

const ddbClient = new DynamoDBClient({ region: process.env.TABLE_REGION });
const ddbDocClient = DynamoDBDocumentClient.from(ddbClient);

const tableName = 'BeltInventory';
const path = '/BeltInventory';

const app = express();
app.use(bodyParser.json());
app.use(awsServerlessExpressMiddleware.eventContext());

app.use(function(req, res, next) {
  res.header("Access-Control-Allow-Origin", "*");
  res.header("Access-Control-Allow-Headers", "*");
  next();
});



app.get(path, async function(req, res) {
  const locationID = req.query.locationID; 
  const scanParams = {
    TableName: tableName
  };

  try {
    const data = await ddbDocClient.send(new ScanCommand(scanParams));

    let items = data.Items;
    if (locationID !== 'all') {
      items = items.filter(item => item.locationID === locationID);
    }
    
    res.json(items);
  } catch (err) {
    console.error('Error scanning DynamoDB:', err);
    res.statusCode = 500;
    res.json({ error: 'Could not load items: ' + err.message });
  }
});

/************************************
* HTTP Put method to update objects *
************************************/

app.put(path, async function(req, res) {
  const { locationID, beltSize, beltsInInventory, numberOfDriveBelts, equipmentUsedOn, loc } = req.body;

  if (!locationID || !beltSize) {
    res.statusCode = 400;
    res.json({ error: 'Missing required parameters: locationID and beltSize' });
    return;
  }

  const updateParams = {
    TableName: tableName,
    Key: {
      locationID: locationID,
      beltSize: beltSize
    },
    UpdateExpression: 'set beltsInInventory = :beltsInInventory, loc = :loc',
    ExpressionAttributeValues: {
      ':beltsInInventory': beltsInInventory,
      ':loc': loc
    },
    ReturnValues: 'ALL_NEW'
  };

  try {
    const result = await ddbDocClient.send(new UpdateCommand(updateParams));
    res.json(result.Attributes);
  } catch (err) {
    console.error('Error updating DynamoDB:', err);
    res.statusCode = 500;
    res.json({ error: 'Could not update item: ' + err.message });
  }
});

// Don't use app.listen() for Lambda, it's unnecessary

// Export the Lambda handler for AWS Lambda integration
const server = awsServerlessExpress.createServer(app);

exports.handler = (event, context) => {
  return awsServerlessExpress.proxy(server, event, context);
};
